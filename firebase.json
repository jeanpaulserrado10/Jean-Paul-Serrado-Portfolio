{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "rewrites": [
      { "source": "/geo", "destination": "/geo/index.html" },
      { "source": "/geo/", "destination": "/geo/index.html" },
      { "source": "/geo/**", "destination": "/geo/index.html" },
      { "source": "/decks/**", "destination": "/decks/:splat" },
      { "source": "/posts/**", "destination": "/posts/:splat" },
      { "source": "/clips/**", "destination": "/clips/:splat" },
      { "source": "**", "destination": "/index.html" }
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|svg|png|jpg|jpeg|webp|gif|woff|woff2|ttf|mp4)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
        ]
      }
    ]
  }
}
